{
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_MODEL": "claude-opus-5-5[1m]"
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.ppk)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_ecdsa)",
      "Read(*api*key*)",
      "Read(*secret*)",
      "Read(.history)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.bash_history)",
      "Read(~/.python_history)",
      "Read(~/AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine/ConsoleHost_history.txt)",
      "Bash(sudo:*)",
      "Bash(rm -rf /)"
    ]
  },
  "awaySummaryEnabled": false,
  "language": "chinese",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "switchModelsOnFlag": false,
  "skipWebFetchPreflight": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "model": "claude-opus-5-5[1m]",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  }
}
