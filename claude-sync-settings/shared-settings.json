{
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.ppk)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_ecdsa)",
      "Read(*api*key*)",
      "Read(*secret*)",
      "Read(.history)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/.credentials.json)",
      "Read(~/.bash_history)",
      "Read(~/.python_history)",
      "Read(~/AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine/ConsoleHost_history.txt)",
      "Bash(sudo:*)",
      "Bash(rm -rf /)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/cc_notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "awaySummaryEnabled": false,
  "enableArtifact": false,
  "language": "chinese",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "switchModelsOnFlag": false,
  "skipWebFetchPreflight": true,
  "skipWorkflowUsageWarning": true,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "5m",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "padding": 0
  },
  "model": "claude-opus-5-5[1m]",
  "modelSettings": {
    "claude-fable-5-2[1m]": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1[1m]": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5[1m]": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5[1m]": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5[1m]": {
      "effortLevel": "medium"
    }
  },
  "$keep": [
    "env.HTTPS_PROXY",
    "env.HTTP_PROXY",
    "env.NO_PROXY",
    "env.https_proxy",
    "env.http_proxy",
    "env.no_proxy",
    "env.NODE_EXTRA_CA_CERTS"
  ],
  "$remove": [
    "env.ANTHROPIC_MODEL",
    "effortLevel",
    {
      "path": "hooks.UserPromptSubmit",
      "item": {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10
          }
        ]
      }
    },
    {
      "path": "hooks.Stop",
      "item": {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10
          }
        ]
      }
    },
    {
      "path": "hooks.StopFailure",
      "item": {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10
          }
        ]
      }
    },
    {
      "path": "hooks.Notification",
      "item": {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10
          }
        ]
      }
    },
    {
      "path": "hooks.PreToolUse",
      "item": {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10
          }
        ]
      }
    },
    {
      "path": "hooks.PostToolUse",
      "item": {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    },
    {
      "path": "hooks.SessionEnd",
      "item": {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/cc_notify.py\"",
            "timeout": 10
          }
        ]
      }
    }
  ]
}
